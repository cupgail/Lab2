m1 = float(input("Введіть масу першого тіла: "))
v1 = float(input("Введіть об'єм першого тіла: "))
m2 = float(input("Введіть масу другого тіла: "))
v2 = float(input("Введіть об'єм другого тіла: "))

r1 = m1 / v1
r2 = m2 / v2

if r1 > r2:
    print(m1, v1)
elif r1 < r2:
    print(m2, v2)
else:
    print("Густина рівна в обох тілах")